# Every link on the site lives here. After editing, run:  node scripts/env-to-config.js
# That writes js/config.js, which the page reads. Leave a value empty to keep the placeholder link (#).
# These values end up in the public page, so keep API keys and secrets OUT of this file
# (the Spotify keys belong in the Vercel project settings, see api/now-playing.js).

# GitHub username (also drives the contribution graph) and profile link
GITHUB_USER=tg1106
GITHUB_URL=https://github.com/tg1106

# About section icons
LINKEDIN_URL=
LEETCODE_URL=
WEBSITE_URL=

# Contact button, and the resume file (a path inside the site, or a full URL)
EMAIL=tharungopinath.work@gmail.com
RESUME_URL=assets/resume.pdf

# Project and research cards, in the order they appear: 1 AI/ML, 2 research, 3 Tide, 4 Little wins, 5 Orbit, 6 data research.
# *_LIVE is the live site, or the paper for the research cards (2 and 6).
PROJECT_1_GITHUB=https://github.com/tg1106/Build-GPT-Tokenizer-from-Scratch
PROJECT_1_LIVE=
PROJECT_2_GITHUB=https://github.com/tg1106/solar-irradiance-india
PROJECT_2_LIVE=
PROJECT_3_GITHUB=https://github.com/tg1106
PROJECT_3_LIVE=
PROJECT_4_GITHUB=https://github.com/tg1106
PROJECT_4_LIVE=
PROJECT_5_GITHUB=https://github.com/tg1106
PROJECT_5_LIVE=
PROJECT_6_GITHUB=https://github.com/tg1106
PROJECT_6_LIVE=
PORTFOLIO_GITHUB=https://github.com/tg1106/Portfolio
PORTFOLIO_LIVE=

# Where the walkman fetches the song from. Leave empty on Vercel (it uses /api/now-playing on the same site).
# Set a full URL only if the page is hosted somewhere else than the API.
NOW_PLAYING_URL=

# Certificate cards: link to each credential
CERT_1_URL=
CERT_2_URL=
CERT_3_URL=

# Walkman data comes from Last.fm (see the top of api/now-playing.js). On the live site these two belong in the Vercel project's
# Environment Variables; here they are only for local runs of `vercel dev`. The key is never copied to the page.
LASTFM_USER=
LASTFM_API_KEY=
